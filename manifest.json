{
  "id": "com.memomind.doom.controller",
  "name": "DOOM Controller",
  "version": "0.1.5",
  "entry": "index.html",
  "bridgeVersion": "2.0",
  "schemaVersion": 2,
  "permissionPolicyVersion": 1,
  "permissions": [
    {
      "name": "display",
      "required": true
    },
    {
      "name": "device.events",
      "required": true,
      "scope": {
        "types": ["connection"]
      }
    },
    {
      "name": "storage",
      "required": false
    },
    {
      "name": "files.user-selected",
      "required": false
    }
  ],
  "deviceRequirements": {
    "preferredPluginId": "com.gm.example.web-bridge",
    "protocols": [
      { "id": "gm.scene", "minVersion": "1.0" },
      { "id": "gm.scene-lz4", "minVersion": "1.0" },
      { "id": "gm.scene-atomic-frame", "minVersion": "1.0" },
      { "id": "gm.device-events", "minVersion": "1.0" }
    ]
  }
}
